# Finance Health Advisor - Environment Configuration
# Copy to .env and customize as needed

# Data Generation
FHA_TOTAL_USERS=10000
FHA_ANOMALY_RATE=0.015
FHA_SEED=42

# ML Models
FHA_N_CLUSTERS=5
FHA_RF_ESTIMATORS=100
FHA_IF_CONTAMINATION=0.02

# UI Settings
FHA_DARK_MODE=false
FHA_PAGE_SIZE=100

# Debug & Logging
FHA_DEBUG=false
FHA_LOG_LEVEL=INFO

# Optional: Streamlit specific
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0